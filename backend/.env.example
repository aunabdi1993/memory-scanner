# Backend configuration. Copy to backend/.env and edit as needed.

# Comma-separated list of allowed CORS origins.
# Use "*" to allow any origin during development.
ALLOWED_ORIGINS=*

# Where photo uploads / processed results are stored on disk.
# Resolved relative to the backend/ working directory.
UPLOADS_DIR=uploads
PROCESSED_DIR=processed

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Sign in with Apple verification.
# APPLE_CLIENT_ID is your iOS bundle id (must match the aud claim Apple
# issues). SESSION_SECRET signs the first-party JWT we hand back to the
# app - rotate this in production.
APPLE_CLIENT_ID=com.memoriesscanner.app
SESSION_SECRET=change-me-in-production

# SQLAlchemy URL for the user store. Defaults to local SQLite.
DATABASE_URL=sqlite:///./memories.db

# ---- Apple In-App Purchase (StoreKit) verification --------------------
# APPLE_BUNDLE_ID matches APPLE_CLIENT_ID for first-party apps. Used as
# the `bid` claim when signing the App Store Server API JWT, and to
# sanity-check `bundleId` on incoming receipts.
APPLE_BUNDLE_ID=com.memoriesscanner.app

# App Store Server API ES256 key. Generate the .p8 in App Store Connect
# under Users and Access -> Keys -> In-App Purchase. ISSUER_ID is the
# top-of-page UUID; KEY_ID is the 10-char ID next to your key.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey.p8

# "sandbox" for TestFlight / dev, "production" for App Store builds.
# Note: receipt verification dispatches per-payload to the right Apple
# host based on the `environment` claim, so this is only a default.
APPLE_ENVIRONMENT=sandbox

# When set, all App Store Server Notifications V2 webhook calls have
# their JWS chain verified against Apple's pinned root. The root is
# embedded in billing.py; this var is a kill switch for local dev.
APPLE_VERIFY_RECEIPT_CHAIN=1
