# Backend configuration. Copy to backend/.env and edit as needed.

# Deployment environment: development | staging | production.
# Non-dev startup will refuse to boot with placeholder secrets or
# "*" CORS origins.
ENV=development

# Comma-separated list of allowed CORS origins.
# Use "*" to allow any origin during development.
ALLOWED_ORIGINS=*

# Largest /scan upload accepted (bytes). Default 15 MB.
MAX_UPLOAD_BYTES=15728640

# Sentry DSN for backend error reporting. Empty disables Sentry.
SENTRY_DSN=

# Where photo uploads / processed results are stored on disk.
# Resolved relative to the backend/ working directory.
UPLOADS_DIR=uploads
PROCESSED_DIR=processed

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Sign in with Apple verification.
# APPLE_CLIENT_ID must equal the App ID's bundle identifier exactly,
# because that's the value Apple stamps as the `aud` claim in the
# identity token. Mismatch => /auth/apple returns 401.
# SESSION_SECRET signs the first-party JWT we hand back to the app —
# rotate this in production and treat as a secret.
APPLE_CLIENT_ID=com.memoriesscanner.app
SESSION_SECRET=change-me-in-production

# SQLAlchemy URL for the user store. Defaults to local SQLite.
DATABASE_URL=sqlite:///./memories.db
