# Backend configuration. Copy to backend/.env and edit as needed.

# Comma-separated list of allowed CORS origins.
# Use "*" to allow any origin during development.
ALLOWED_ORIGINS=*

# Where photo uploads / processed results are stored on disk.
# Resolved relative to the backend/ working directory.
UPLOADS_DIR=uploads
PROCESSED_DIR=processed

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
