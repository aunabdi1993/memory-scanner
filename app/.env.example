# Expo public env vars (must be prefixed EXPO_PUBLIC_ to reach the bundle).

# Backend base URL. Use http://localhost:8000 for the simulator, or your
# Mac's LAN IP (e.g. http://192.168.1.42:8000) when running on a real
# iPhone alongside `npx expo start --tunnel` is fine too.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
